# Copy to .env and fill in values. Never commit .env.

GEMINI_API_KEY=

ELEVENLABS_API_KEY=

# Reddit API (read-only "script" app) — create free at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# TikTok Content Posting API — needs a TikTok developer app with the
# video.upload scope only (not video.publish — that needs an audit and isn't
# used here; uploads land in the creator's draft inbox for a human to publish).
# Access tokens expire in 24h; TIKTOK_REFRESH_TOKEN + CLIENT_KEY/SECRET let the
# pipeline refresh automatically (src/publish/tiktok.py) instead of dying silently.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Graph API — needs a Business/Creator IG account linked to a
# Facebook Page, and an app with Facebook Login for Business (required for the
# resumable local-file upload path used here — the plain video_url path needs
# a public URL, which doesn't fit a local pipeline). Long-lived tokens last 60
# days; refreshed automatically (src/publish/instagram.py) ~7 days before expiry.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
